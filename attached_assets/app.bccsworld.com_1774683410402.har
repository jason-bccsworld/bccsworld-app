          "content": {
            "size": 3533,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no\" />\n    <meta name=\"theme-color\" content=\"#0ea5e9\" />\n    <meta name=\"description\" content=\"BCCS-US - Aviation Compliance Platform for training organizations and regulatory bodies\" />\n    <meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"default\" />\n    <meta name=\"apple-mobile-web-app-title\" content=\"BCCS-US\" />\n    <link rel=\"manifest\" href=\"/manifest.json\" />\n    <link rel=\"apple-touch-icon\" href=\"/icons/icon-192x192.png\" />\n    <title>BCCS-US - Aviation Compliance Platform</title>\n    <script>\n      // NUCLEAR CACHE CLEAR v3.0.0\n      console.log('FORCING COMPLETE CACHE CLEAR...');\n      \n      // Clear all storage\n      localStorage.clear();\n      sessionStorage.clear();\n      \n      // Clear service worker cache\n      if ('serviceWorker' in navigator) {\n        navigator.serviceWorker.getRegistrations().then(function(registrations) {\n          for(let registration of registrations) {\n            registration.unregister();\n          }\n        });\n      }\n      \n      // Clear all caches\n      if ('caches' in window) {\n        caches.keys().then(names => {\n          names.forEach(name => {\n            console.log('Deleting cache:', name);\n            caches.delete(name);\n          });\n        });\n      }\n      \n      // Force page reload without cache\n      if (performance.navigation.type !== 1) {\n        console.log('Reloading page to clear cache...');\n        window.location.reload(true);\n      }\n    </script>\n    <script type=\"module\" crossorigin src=\"/assets/index-C0bGIHpC.js\"></script>\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-BNrUQUAs.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script>\n      // Disable HMR overlay globally before Vite loads\n      window.__vite_plugin_react_preamble_installed__ = true;\n      \n      // Override Vite's HMR overlay configuration\n      if (window.__vite_is_modern_browser) {\n        window.__vite_plugin_react_preamble_installed__ = true;\n      }\n      \n      // Set HMR overlay to false\n      window.__vite_hmr_overlay_disabled = true;\n      \n      // Suppress Replit runtime error overlay\n      window.__replit_runtime_error_plugin_disabled = true;\n      \n      // Override console methods to suppress specific errors\n      const originalError = console.error;\n      console.error = function(...args) {\n        const message = args.join(' ');\n        if (message.includes('useRef') || message.includes('runtime-error-plugin')) {\n          return; // Suppress these specific errors\n        }\n        originalError.apply(console, args);\n      };\n\n      // Register service worker for PWA functionality\n      if ('serviceWorker' in navigator) {\n        window.addEventListener('load', () => {\n          navigator.serviceWorker.register('/sw.js')\n            .then(registration => {\n              console.log('SW registered: ', registration);\n            })\n            .catch(registrationError => {\n              console.log('SW registration failed: ', registrationError);\n            });\n        });\n      }\n    </script>\n    <!-- This is a replit script which adds a banner on the top of the page when opened in development mode outside the replit environment -->\n    <script type=\"text/javascript\" src=\"https://replit.com/public/js/replit-dev-banner.js\"></script>\n  </body>\n</html>"
