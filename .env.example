# =============================================================================
# BCCS-US Aviation Compliance Platform — Environment Variables
# Copy this file to .env for local development
# Set these as Environment Variables in Vercel for production
# =============================================================================

# ── Database (Required) ───────────────────────────────────────────────────────
# PostgreSQL connection string — use Neon (https://neon.tech) for Vercel
DATABASE_URL=postgresql://username:password@hostname/dbname?sslmode=require

# ── Session Security (Required) ───────────────────────────────────────────────
# Generate a strong random string: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# ── Admin Account Bootstrap (Required for first login) ───────────────────────
# On first startup, the system creates an admin account with these credentials
# IMPORTANT: Change the password immediately after first login
ADMIN_EMAIL=admin@yourorganization.com
ADMIN_PASSWORD=change-this-strong-password

# ── OpenAI (Required for AI features) ────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Anthropic (Optional — used by Legacy Data Transfer) ──────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Blockchain RPC Providers (Optional — used by blockchain features) ─────────
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
# POLYGON_RPC_URL=https://polygon-rpc.com

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=production
